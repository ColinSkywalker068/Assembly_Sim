@@ -0,0 +1,58 @@
+"""The bench's runtime robot (setup.yaml `runtime_robot`), for benches whose arms are joint-position servos and whose
+hands are parallel grippers on slide joints (the CRX + YAM port). A bench without these keys, DexAgent's own YAM +
+Sharpa setup, keeps the library's built-in values everywhere.
+"""
+from __future__ import annotations
+
+from functools import lru_cache
+from pathlib import Path
+
+import yaml
+
+SETUP = Path(__file__).resolve().parents[2] / "setup"
+
+
+@lru_cache(maxsize=8)
+def _runtime(setup_dir: str) -> dict:
+    path = Path(setup_dir) / "setup.yaml"
+    data = yaml.safe_load(path.read_text()) if path.is_file() else {}
+    return dict((data or {}).get("runtime_robot") or {})
+
+
+def runtime(setup_dir=None) -> dict:
+    """`runtime_robot` of the setup folder (DexAgent's setup/ by default); {} when it has none."""
+    return dict(_runtime(str(Path(setup_dir or SETUP).resolve())))
+
+
+def setup_dir_of(setup_scene=None) -> Path:
+    """The setup folder of a setup scene path (DexAgent's own by default)."""
+    return Path(setup_scene).resolve().parent if setup_scene is not None else SETUP
+
+
+def joint_position_arm(setup_dir=None) -> bool:
+    """Whether the bench's arms are joint-position servos (rather than DexAgent's torque-capped impedance arm)."""
+    return runtime(setup_dir).get("arm_control") == "joint_position"
+
+
+def value(key, default, setup_dir=None):
+    """A runtime_robot value, or `default` for a bench that does not set it."""
+    rt = runtime(setup_dir)
+    return rt[key] if key in rt else default
+
+
+@lru_cache(maxsize=8)
+def _setup(setup_dir: str) -> dict:
+    path = Path(setup_dir) / "setup.yaml"
+    return dict((yaml.safe_load(path.read_text()) if path.is_file() else None) or {})
+
+
+def parallel_gripper(setup_dir=None) -> bool:
+    """Whether the bench's hands are parallel grippers (its runtime robot gives their jaws a speed)."""
+    return value("finger_speed_m_s", None, setup_dir) is not None
+
+
+def hand_xml(side, setup_dir=None) -> Path:
+    """The hand file of a station: setup.yaml `stations.<side>.hand_xml`, else DexAgent's Sharpa file."""
+    folder = Path(setup_dir or SETUP).resolve()
+    station = (_setup(str(folder)).get("stations") or {}).get(side) or {}
+    return folder / station.get("hand_xml", f"robot/sharpa_{side}.xml")
