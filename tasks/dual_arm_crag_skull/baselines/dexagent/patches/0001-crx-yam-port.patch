+"""Will the shared hardware's safety layer (S0) run this delivery?"""
+from __future__ import annotations
+
+TOOL = {
+    "name": "s0_delivery_check",
+    "title": "S0 delivery check",
+    "type": "verifier",
+    "category": "Task & Rollout Gates",
+    "summary": "Runs the delivered trajectory through S0, the safety layer of the robot it will be executed on: every "
+               "command at S0's servo rate within the joint speed and acceleration limits, the arms apart, links and "
+               "tools off the table, and near the table only inside a grasp or place contact and slowly. Fails at the "
+               "first command S0 would refuse.",
+    "description": (
+        "The delivery is executed on the CRX + YAM hardware through S0, which refuses (never slows or reshapes) any "
+        "command outside its limits, and a refusal ends the run. This check replays the delivery exactly as it will "
+        "be executed, from the arms' home (a delivery that starts elsewhere is refused): the commanded joint "
+        "reference ramped at S0's servo rate (60 Hz), each jaw target as the gripper's width, in chunks checked "
+        "from the state before them, assuming the arms track the commands exactly. S0 reads the first segment of a "
+        "chunk as a constant acceleration from the measured velocity, so chunks start where the commanded velocity "
+        "changes least (between frames), at most 1 s apart, and at the first command in the band or the one before "
+        "it, whichever changes less; on the 30 fps ramp a frame's velocity change happens "
+        "within one servo period, so S0 reads twice the planned acceleration at each frame. Near the table (the "
+        "finger box within S0's table clearance, or the tool centre below its minimum height) an arm needs a contact "
+        "window, declared when its chunk starts, from the phase label of its first command in that band, on what is "
+        "observed then: approaching, closing on, gripping or lifting a fragment opens a grasp window centred where the "
+        "fragment is; carrying, setting down, letting go of or settling after it opens a place window centred on its "
+        "goal when the fragment is within S0's contact radius of its goal, else a grasp window centred where the "
+        "fragment is (set down where it is); any other phase keeps the last window; the fixture-held anchor is never "
+        "a contact. A window stays while the arm is in the band. Inside it the fingers must stay within the window's "
+        "radius, a few millimetres above the table, and every corner of the finger box slower than S0's contact "
+        "speed. The release-and-settle hold that ends every trial is checked too. The S0 limits, the home and the "
+        "task come from the run's S0 spec (DEXAGENT_S0_SPEC)."
+    ),
+    "inputs": [
+        {"name": "trajectory", "type": "str", "description": "The rigid runtime trajectory.npz to be delivered."},
+        {"name": "spec", "type": "str | None", "description": "The S0 spec json (default: the run's DEXAGENT_S0_SPEC)."},
+    ],
+    "outputs": [
+        {"name": "report", "type": "dict", "description": "ok, issues, status (completed | rejected | refused), reason (S0's refusal, with the time), steps (servo steps that pass before it), windows [{time_s, arm, kind, fragment, center_xy}]."},
+    ],
+    "requirements": ["numpy", "scipy"],
+    "simulators": [],
+    "tags": ["stage3", "gate", "safety", "s0", "execution"],
+    "used_in": [],
+    "status": "tested",
+    "entrypoint": "s0_delivery_check",
+}
+
+import json
+import os
+import sys
+from pathlib import Path
+
